# Copy to terraform.tfvars (gitignored) and fill in.
aws_profile    = "claude-deploy"
aws_region     = "ap-south-1"
aws_account_id = "123456789012"

availability_zone = "ap-south-1a"
ec2_instance_type = "t3.micro"     # or "t4g.micro" (arm64 images)
db_instance_class = "db.t4g.micro"

bucket_suffix    = "changeme"      # globally unique: atomcap-kyc-videos-<suffix>
s3_force_destroy = true            # set false once real customer data exists

domain_name = ""                   # e.g. "api.example.com"; empty = HTTP on Elastic IP
alert_email = "you@example.com"

monthly_budget_usd = 5
